{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuoForge JumPHP WASM Game Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engine", "id", "title", "entry", "width", "height", "controls"],
  "properties": {
    "schemaVersion": {"const": 1},
    "engine": {"const": "jumphp-wasm"},
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},
    "title": {"type":"string","minLength":1,"maxLength":100},
    "entry": {"const": "./index.html"},
    "width": {"type":"integer","minimum":160,"maximum":3840},
    "height": {"type":"integer","minimum":160,"maximum":2160},
    "controls": {"type":"array","maxItems":4,"uniqueItems":true,"items":{"enum":["keyboard","touch","gamepad","mouse"]}}
  }
}
